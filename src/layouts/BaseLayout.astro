---
import '../styles/global.css';
import { SITE, ORG_ID, WEBSITE_ID, personId, projectId } from '../data/site';
import { team } from '../data/team';
import { projects } from '../data/projects';
import { association } from '../data/association';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD nodes merged into the single page-wide `@graph`. */
  jsonLdNodes?: Record<string, unknown>[];
  /** Error pages (404): drop the canonical and set noindex, follow. */
  noindex?: boolean;
}

const { title, description, jsonLdNodes = [], noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// The bureau as Person nodes, linked to the NGO via memberOf (not employee:
// they are volunteers, not staff) and referenced back from the NGO's own
// `member` list — a plain, bidirectional link rather than an OrganizationRole
// indirection, which most consumers ignore anyway.
const personNodes = team.map((member) => ({
  '@type': 'Person',
  '@id': personId(member.slug),
  name: member.name,
  jobTitle: member.role,
  ...(member.bio ? { description: member.bio } : {}),
  ...(member.url ? { url: member.url, sameAs: [member.url] } : {}),
  memberOf: { '@id': ORG_ID },
  knowsLanguage: 'fr',
}));

// JSON-LD: NGO + WebSite in a single @graph so search engines and AI answer
// engines (GEO) can extract the entity and its facts.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NGO',
      '@id': ORG_ID,
      name: association.name,
      legalName: association.legalName,
      url: SITE,
      email: association.email,
      description: association.description,
      image: ogImage.href,
      foundingDate: association.foundingYear,
      foundingLocation: { '@type': 'Place', name: 'Nantes, France' },
      slogan: association.slogan,
      areaServed: association.areaServed,
      knowsAbout: association.knowsAbout,
      location: {
        '@type': 'Place',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Nantes',
          addressRegion: association.addressRegion,
          postalCode: association.postalCode,
          addressCountry: 'FR',
        },
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: association.email,
        contactType: 'customer support',
        areaServed: 'FR',
        availableLanguage: ['French'],
      },
      // Registries that identify this exact legal entity — not the project
      // sites, which are separate organizations naomakers.com merely hubs to.
      sameAs: [association.pappersUrl, association.dataGouvUrl],
      // SIRET/SIREN are French registration numbers, not tax IDs (taxID
      // expects a fiscal/VAT number, which a non-profit typically has none
      // of) — exposed generically via `identifier`.
      identifier: [
        {
          '@type': 'PropertyValue',
          propertyID: 'SIRET',
          name: 'Numéro SIRET',
          value: association.siretDigits,
        },
        {
          '@type': 'PropertyValue',
          propertyID: 'SIREN',
          name: 'Numéro SIREN',
          value: association.siren,
        },
        {
          '@type': 'PropertyValue',
          propertyID: 'RNA',
          name: 'Numéro RNA (répertoire national des associations)',
          value: association.rna,
        },
      ],
      // schema.org's `nonprofitStatus` enum only covers US and NL statuses;
      // a French "loi 1901" status has no matching value, so it is stated
      // as plain text instead of forcing an invalid enum member.
      additionalProperty: [
        {
          '@type': 'PropertyValue',
          name: 'Statut juridique',
          value: association.legalStatus,
        },
        {
          '@type': 'PropertyValue',
          name: "Pays d'immatriculation",
          value: 'France',
        },
      ],
      member: team.map((member) => ({ '@id': personId(member.slug) })),
      events: projects.map((project) => ({ '@id': projectId(project.slug) })),
    },
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      name: association.name,
      url: SITE,
      inLanguage: 'fr-FR',
      publisher: { '@id': ORG_ID },
    },
    ...personNodes,
    ...jsonLdNodes,
  ],
};

// A stray "</script>" inside any node (e.g. FAQ copy) would terminate the
// script element early and break the page; escape "<" defensively.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="author" content="Naomakers" />
    <meta name="theme-color" content="#fbfbf7" />
    {!noindex && <link rel="canonical" href={canonicalURL.href} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Naomakers" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Naomakers · association nantaise pour le numérique, la tech et l'IA"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23c6f000'/><g fill='%231a1b26'><rect x='24' y='24' width='16' height='52'/><rect x='60' y='24' width='16' height='52'/><polygon points='24,24 40,24 76,76 60,76'/></g></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <script type="application/ld+json" set:html={jsonLdText} is:inline />
  </head>
  <body>
    <slot />

    <footer class="footer">
      <div class="container">
        <div class="titleblock">
          <div class="field">
            <span class="mono label">Organisation</span>
            <span class="value">{association.name}</span>
          </div>
          <div class="field">
            <span class="mono label">Localisation</span>
            <span class="value">Nantes, FR</span>
          </div>
          <div class="field">
            <span class="mono label">Depuis</span>
            <!-- Discreet contact: the "·" is a mailto to team@naomakers.com -->
            <span class="value"
              >{association.foundingYear}<a
                class="contact-dot"
                href={`mailto:${association.email}`}
                aria-label="Nous contacter">✉</a
              ></span
            >
          </div>
          <div class="field">
            <span class="mono label">Statut</span>
            <a
              class="value value-link"
              href={association.statutesUrl}
              target="_blank"
              rel="noopener"
              aria-label="Voir les statuts de l'association"
              >Association loi 1901</a
            >
          </div>
          <div class="field">
            <span class="mono label">SIRET</span>
            <a
              class="value value-link"
              href={association.pappersUrl}
              target="_blank"
              rel="noopener"
              aria-label="Voir la fiche Pappers de l'association"
              >{association.siretDisplay}</a
            >
          </div>
          <div class="field">
            <span class="mono label">ID association</span>
            <span class="value">{association.rna}</span>
          </div>
        </div>
      </div>
    </footer>

    <style>
      .footer {
        margin-top: var(--space-8);
        padding-block: var(--space-4);
      }

      .titleblock {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border: 1.5px solid var(--ink);
        background: var(--surface);
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding: var(--space-2);
        border-right: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
      }

      .field:nth-child(3n) {
        border-right: 0;
      }

      .field:nth-last-child(-n + 3) {
        border-bottom: 0;
      }

      .label {
        color: var(--muted);
      }

      .value {
        font-weight: 500;
      }

      .value-link {
        color: inherit;
        text-decoration: underline dotted;
        text-underline-offset: 3px;
        transition: color var(--dur) var(--ease);
      }

      .value-link:hover {
        color: var(--muted);
      }

      .contact-dot {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        min-height: 24px;
        vertical-align: middle;
        text-decoration: none;
        color: var(--ink);
        font-size: 0.9em;
        transition: opacity var(--dur) var(--ease);
      }

      .contact-dot:hover {
        opacity: 1;
        color: var(--ink);
      }

      @media (max-width: 640px) {
        .titleblock {
          grid-template-columns: 1fr 1fr;
        }

        .field:nth-child(3n) {
          border-right: 1px solid var(--border);
        }

        .field:nth-child(2n) {
          border-right: 0;
        }

        .field:nth-last-child(-n + 3) {
          border-bottom: 1px solid var(--border);
        }

        .field:nth-last-child(-n + 2) {
          border-bottom: 0;
        }
      }
    </style>
  </body>
</html>
