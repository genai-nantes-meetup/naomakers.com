---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TeamMember from '../components/TeamMember.astro';
import FaqItem from '../components/FaqItem.astro';
import { projects } from '../data/projects';
import { team } from '../data/team';
import { faq } from '../data/faq';
import { ORG_ID, WEBPAGE_ID, WEBSITE_ID, projectId } from '../data/site';

const title = 'Naomakers · association numérique, tech et IA à Nantes';
const description =
  "Naomakers, association à but non lucratif, promeut le numérique, la tech et l'IA générative à Nantes et accompagne l'écosystème tech : hackathons, meetups et conférences.";

const count = String(projects.length).padStart(2, '0');
const teamCount = String(team.length).padStart(2, '0');
const faqCount = String(faq.length).padStart(2, '0');

// JSON-LD: the projects as an ItemList of recurring event series, merged
// into BaseLayout's single @graph, so search engines and AI answer engines
// can enumerate what Naomakers runs.
const itemList = {
  '@type': 'ItemList',
  name: 'Projets de Naomakers',
  mainEntityOfPage: { '@id': WEBPAGE_ID },
  itemListElement: projects.map((project, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': project.eventType
        ? ['EventSeries', project.eventType]
        : 'EventSeries',
      // Referenced from the NGO's `events` list, so the project needs a
      // stable @id to resolve against, not just an inline object.
      '@id': projectId(project.slug),
      name: project.title,
      description: project.description,
      ...(project.url ? { url: project.url } : {}),
      organizer: { '@id': ORG_ID },
      location: { '@type': 'Place', name: 'Nantes, France' },
      ...(project.rating
        ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: project.rating.value,
              ratingCount: project.rating.count,
              bestRating: project.rating.bestRating,
            },
          }
        : {}),
      ...(project.stats?.length
        ? {
            additionalProperty: project.stats.map((stat) => ({
              '@type': 'PropertyValue',
              name: stat.label,
              value: stat.value,
            })),
          }
        : {}),
    },
  })),
};

// The page itself is both a WebPage and a FAQPage: one node for this URL
// rather than a separate FAQPage node competing with it. mainEntity is
// reserved for the Question list (Google's requirement); the ItemList above
// stays a sibling node and points back here via mainEntityOfPage.
const webPage = {
  '@type': ['WebPage', 'FAQPage'],
  '@id': WEBPAGE_ID,
  url: 'https://naomakers.com',
  name: title,
  description,
  inLanguage: 'fr-FR',
  isPartOf: { '@id': WEBSITE_ID },
  about: { '@id': ORG_ID },
  primaryImageOfPage: 'https://naomakers.com/og.png',
  mainEntity: faq.map((entry) => ({
    '@type': 'Question',
    name: entry.question,
    acceptedAnswer: { '@type': 'Answer', text: entry.answer },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLdNodes={[itemList, webPage]}
>
  <div class="container">
    <div class="sheet">
      <div class="topbar">
        <a href="/" class="wordmark">Naomakers</a>
        <nav class="nav mono" aria-label="Sections de la page">
          <a href="#projets">Projets</a>
          <a href="#equipe">Équipe</a>
          <a href="#faq">FAQ</a>
        </nav>
      </div>

      <header class="hero">
        <p class="eyebrow mono">
          Association loi 1901 · Nantes · numérique, tech &amp; IA
        </p>
        <h1>
          L'association qui fait rayonner<br />le numérique, la tech et l'IA, à
          Nantes.
        </h1>
        <p class="lede">
          Naomakers promeut le secteur du numérique sur le territoire nantais et
          accompagne les personnes comme les acteurs de l'écosystème
          technologique. On agit à travers des hackathons, des meetups et des
          conférences ouverts à toutes et tous.
        </p>
      </header>

      <section id="projets" aria-labelledby="projets-heading">
        <div class="section-label">
          <h2 class="mono" id="projets-heading">Nos projets</h2>
          <span class="mono count">[ {count} ]</span>
        </div>

        <div class="grid">
          {
            projects.map((project, i) => (
              <ProjectCard project={project} index={i + 1} />
            ))
          }
        </div>
      </section>

      <section id="equipe" aria-labelledby="equipe-heading">
        <div class="section-label section-label--team">
          <h2 class="mono" id="equipe-heading">L'équipe</h2>
          <span class="mono count">[ {teamCount} ]</span>
        </div>

        <p class="team-lede">
          Le bureau de l'association, tenu bénévolement par des acteurs de
          l'écosystème tech nantais.
        </p>

        <div class="grid">
          {
            team.map((member, i) => (
              <TeamMember member={member} index={i + 1} />
            ))
          }
        </div>
      </section>

      <section id="faq" aria-labelledby="faq-heading">
        <div class="section-label section-label--team">
          <h2 class="mono" id="faq-heading">Questions fréquentes</h2>
          <span class="mono count">[ {faqCount} ]</span>
        </div>

        <div class="faq-list">
          {faq.map((entry, i) => <FaqItem entry={entry} index={i + 1} />)}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .sheet {
    margin-top: var(--space-6);
    background: var(--surface);
    border: 1.5px solid var(--ink);
    padding: clamp(var(--space-3), 4vw, var(--space-6));
  }

  .topbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--space-2);
    border-bottom: 1.5px solid var(--ink);
  }

  .wordmark {
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .nav a {
    /* WCAG 2.2 AA target size (DESIGN.md): the mono face sits at
       --step--1 (0.8rem), so the tap target needs an explicit floor. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .hero {
    padding-block: clamp(var(--space-6), 8vw, var(--space-8));
    max-width: 44rem;
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: 0.3rem 0.6rem;
    background: var(--accent);
    color: var(--ink);
    font-weight: 700;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6.5vw, var(--step-4));
  }

  .lede {
    max-width: 40rem;
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: 1.5px solid var(--ink);
  }

  .section-label--team {
    margin-top: var(--space-8);
    margin-bottom: var(--space-2);
  }

  .team-lede {
    max-width: 40rem;
    margin: 0 0 var(--space-4);
    color: var(--muted);
  }

  .section-label h2 {
    margin: 0;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
  }

  .count {
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .faq-list {
    display: grid;
    /* Full-width rows, not the 2×2 card grid: FAQ copy reads better as a
       single column than split across two. */
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
