---
import { PUBLIC_POSTHOG_KEY } from 'astro:env/client';
import { buildPostHogSnippet, POSTHOG_API_HOST } from '../lib/posthog-snippet';

// Analytics only ships in production builds: `astro dev` renders neither
// tag below, so local browsing never hits the proxy and never pollutes the
// PostHog project. `import.meta.env.PROD` is resolved at build time, so
// `astro preview` (which serves the already-built `dist/`) reflects
// whatever was true at build time, not at preview time.
const snippet =
  import.meta.env.PROD && PUBLIC_POSTHOG_KEY
    ? buildPostHogSnippet(PUBLIC_POSTHOG_KEY)
    : null;

// Google Analytics 4 measurement ID. Public by design — every gtag.js tag
// is visible in a page's rendered source on any site that uses it — so,
// unlike `PUBLIC_POSTHOG_KEY`, there's no reason to route it through an
// env var.
const GA_MEASUREMENT_ID = 'G-QB3D90GHBQ';
const gaScriptUrl = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
const gaConfigSnippet = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(GA_MEASUREMENT_ID)});`;
---

{snippet && <link rel="preconnect" href={POSTHOG_API_HOST} crossorigin />}
{
  /* `is:inline` is required: a processed <script> is bundled by Vite and
     re-emitted as a deferred `type="module"`, but the array-loader must run
     synchronously while the head is still parsing. `set:html` is the only
     way to interpolate the frontmatter-built snippet into the script's
     content, since braces inside a <script> are raw text to the Astro
     compiler, not an expression slot. */
}
{snippet && <script is:inline set:html={snippet} />}

{
  import.meta.env.PROD && (
    <link
      rel="preconnect"
      href="https://www.googletagmanager.com"
      crossorigin
    />
  )
}
{
  /* Same production-only gating and `is:inline` reasoning as the PostHog
     snippet above. Order matters: gtag.js reads `window.dataLayer` as soon
     as it loads, so the array (and the queued `config` call) must already
     exist in the DOM before or in parallel with — never after — the
     external script tag. */
}
{import.meta.env.PROD && <script async is:inline src={gaScriptUrl} />}
{import.meta.env.PROD && <script is:inline set:html={gaConfigSnippet} />}
