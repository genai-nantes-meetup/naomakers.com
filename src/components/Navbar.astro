---
const currentPath = Astro.url.pathname;
---

<div class="topbar">
  <a href="/" class="wordmark">Naomakers</a>
  <nav class="nav mono" aria-label="Sections de la page">
    <a href="/#projets" class:active={currentPath === '/'}>Projets</a>
    <a href="/team" class:active={currentPath === '/team'}>Team</a>
    <a href="/#faq" class:active={currentPath === '/'}>FAQ</a>
  </nav>
</div>

<style>
  .topbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--space-2);
    border-bottom: 1.5px solid var(--ink);
  }

  .wordmark {
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .nav a:hover,
  .nav a.active {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
</style>
