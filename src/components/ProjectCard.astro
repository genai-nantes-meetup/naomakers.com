---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
  /** True for the card above the fold, so its image loads eagerly (LCP). */
  priority?: boolean;
}

const { project, index, priority = false } = Astro.props;
const {
  title,
  kind,
  slug,
  description,
  url,
  image,
  imageAlt,
  wip,
  rating,
  stats,
  teamMembers,
} = project;

// Upcoming projects have no external link and render as a plain card.
// Tag is always <div> to avoid nested <a> issues (browsers auto-close
// outer anchors when encountering nested ones, leaving the card link broken).
// Card-level click navigation is handled by the script below.
const Tag = 'div';
// `noreferrer` is intentionally omitted (unlike the footer's own external
// links) so satellite sites can see the naomakers.com referral in their
// analytics. `data-analytics-*` is picked up by the delegated click
// listener in `BaseLayout.astro` — no per-component JS import needed.
const linkAttrs = url
  ? {
      'data-url': url,
      'data-analytics-event': 'project_card_clicked',
      'data-analytics-project': slug,
    }
  : {};
const num = String(index).padStart(2, '0');

// French decimal comma for the visible rating; the JSON-LD keeps the raw
// number (schema.org normalizes the dot notation regardless of locale).
const nf = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1 });

// The rating is a distinct schema.org property (aggregateRating) but reads
// as just another row of the same technical spec sheet.
const specs: { label: string; value: string }[] = [
  ...(rating
    ? [
        {
          label: 'Note',
          value: `★ ${nf.format(rating.value)}/${rating.bestRating} · ${rating.count} avis`,
        },
      ]
    : []),
  ...(stats ?? []).map((stat) => ({
    label: stat.label,
    value: String(stat.value),
  })),
];
---

<Tag class:list={['card', { 'card--wip': wip }]} {...linkAttrs}>
  <header class="card-head">
    <span class="idx mono">{num}</span>
    <span class="kind mono">{kind}</span>
  </header>

  <div class="card-media">
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt ?? `Visuel du projet ${title}`}
          widths={[400, 560, 800, 1100]}
          sizes="(max-width: 760px) 100vw, 520px"
          priority={priority}
        />
      ) : (
        <div class="hatch" aria-hidden="true" />
      )
    }
    {wip && <span class="tag mono">Bientôt</span>}
  </div>

  <div class="card-body">
    <h3>{title}</h3>
    <p>{description}</p>
    {
      teamMembers.length > 0 && (
        <div class="team-bar">
          {teamMembers.map((member) => (
            member.url ? (
              <a
                href={member.url}
                target="_blank"
                rel="noopener"
                class="team-photo"
                aria-label={member.name}
                data-analytics-event="team_member_clicked"
                data-analytics-project={slug}
                data-analytics-member={member.slug}
              >
                {member.photo && (
                  <Image
                    src={member.photo}
                    alt={member.name}
                    width={40}
                    height={40}
                    sizes="40px"
                  />
                )}
                <span class="team-name">{member.name}</span>
              </a>
            ) : (
              <span
                class="team-photo"
                aria-label={member.name}
                data-analytics-event="team_member_clicked"
                data-analytics-project={slug}
                data-analytics-member={member.slug}
              >
                {member.photo && (
                  <Image
                    src={member.photo}
                    alt={member.name}
                    width={40}
                    height={40}
                    sizes="40px"
                  />
                )}
                <span class="team-name">{member.name}</span>
              </span>
            )
          ))}
        </div>
      )
    }
    <div class="card-footer">
      {
        specs.length > 0 && (
          <dl class="specs">
            {specs.map((spec) => (
              <div class="spec">
                <dt class="mono">{spec.label}</dt>
                <dd>{spec.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        url && (
          <span class="card-link mono">
            Découvrir <span class="arrow">→</span>
          </span>
        )
      }
    </div>
  </div>
</Tag>

<script is:inline>
  // Handle card clicks: the outer <Tag> is now a <div> (no nested <a>)
  // so navigation to the project URL must be done via this script.
  document.addEventListener('click', (e) => {
    // Let native <a> links (team members with a URL) handle their own clicks
    if (e.target.closest('a')) return;
    // Don't intercept team-member spans (no URL) — they're not navigable
    if (e.target.closest('.team-bar [data-analytics-event="team_member_clicked"]')) return;
    const card = e.target.closest('[data-url]');
    if (card) {
      e.preventDefault();
      e.stopPropagation();
      window.open(card.dataset.url, '_blank', 'noopener');
    }
  });
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1.5px solid var(--ink);
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 0 var(--accent);
  }

  .card-head {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--space-2);
    border-bottom: 1.5px solid var(--ink);
  }

  .idx {
    display: grid;
    place-items: center;
    padding-inline: var(--space-2);
    background: var(--accent);
    color: var(--ink);
    font-weight: 700;
  }

  .kind {
    display: flex;
    align-items: center;
    padding: 0.6rem var(--space-2);
    color: var(--muted);
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    border-bottom: 1.5px solid var(--ink);
    overflow: hidden;
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Unify the disparate source visuals; resolve to full colour on hover. */
    filter: grayscale(0.35) contrast(1.03);
    transition: filter var(--dur) var(--ease);
  }

  .card:hover .card-media :global(img) {
    filter: grayscale(0) contrast(1);
  }

  .hatch {
    width: 100%;
    height: 100%;
    background-color: var(--accent);
    background-image: repeating-linear-gradient(
      -45deg,
      var(--ink) 0 1.5px,
      transparent 1.5px 15px
    );
    opacity: 0.9;
  }

  .tag {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    padding: 0.25rem 0.55rem;
    background: var(--ink);
    color: var(--bg);
    font-weight: 700;
  }

  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
  }

  .card-body h3 {
    margin: 0;
    font-size: var(--step-1);
  }

  .card-body p {
    margin: 0;
    color: var(--muted);
    font-size: var(--step-0);
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    /* Pushes the spec sheet + link to the bottom of the card so cards with
       0, 2 or 4 spec rows still align across the 2×2 grid. */
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    /* Filets = gouttières: the border fill shows through the 1px grid gap,
       so 1 to 4 cells lay out without any nth-child arithmetic. */
    border: 1px solid var(--border);
    background: var(--border);
  }

  /* Odd cell count: let the last one span the full width, otherwise the
     empty half-cell would show the --border fill as a bare grey block. */
  .spec:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .spec {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: var(--space-1);
    background: var(--surface);
  }

  .spec dt {
    color: var(--muted);
  }

  .spec dd {
    /* Reset the UA default (margin-inline-start: 40px on <dd>). */
    margin: 0;
    font-weight: 500;
    font-size: var(--step-0);
    font-variant-numeric: tabular-nums;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    font-weight: 700;
  }

  .arrow {
    display: inline-block;
    transition: transform var(--dur) var(--ease);
  }

  .card:hover .arrow {
    transform: translateX(4px);
  }

  .team-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
    min-width: 0;
  }

  .team-photo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .team-photo img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    object-fit: cover;
    transition: border-color var(--dur) var(--ease);
  }

  .team-photo:hover img {
    border-color: var(--accent);
  }

  .team-name {
    font-size: var(--step--1);
    color: var(--muted);
    transition: color var(--dur) var(--ease);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 8rem;
  }

  .team-photo:hover .team-name {
    color: var(--ink);
  }

  .card--wip {
    cursor: default;
  }
</style>
