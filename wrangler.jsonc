{
  // Worker name must match the Workers Builds project in the Cloudflare
  // dashboard; names allow only lowercase alphanumerics and dashes.
  "name": "naomakers-com",
  // Pins the Workers runtime behaviour to the date this config was written.
  "compatibility_date": "2026-11-22",
  "assets": {
    // Static output of `astro build`.
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page"
  }
}
